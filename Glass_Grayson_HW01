import java.util.Scanner;

public class Main {
    public static void main(String[] args) {
        Scanner in = new Scanner(System.in);

        // Get Player A's move
        System.out.print("Player A, enter R, P, or S: ");
        String playerA = in.nextLine();

        if (!playerA.equalsIgnoreCase("R")
                && !playerA.equalsIgnoreCase("P")
                && !playerA.equalsIgnoreCase("S")) {
            System.out.println("Error: Invalid move from Player A.");
            System.exit(0);
        }

        // Get Player B's move
        System.out.print("Player B, enter R, P, or S: ");
        String playerB = in.nextLine();

        if (!playerB.equalsIgnoreCase("R")
                && !playerB.equalsIgnoreCase("P")
                && !playerB.equalsIgnoreCase("S")) {
            System.out.println("Error: Invalid move from Player B.");
            System.exit(0);
        }

        // Display the moves
        System.out.println("Player A chose: " + playerA.toUpperCase());
        System.out.println("Player B chose: " + playerB.toUpperCase());

        // Determine the result
        if (playerA.equalsIgnoreCase(playerB)) {
            System.out.println("It's a Tie!");
        } else if (
                (playerA.equalsIgnoreCase("R")
                        && playerB.equalsIgnoreCase("S"))
                        || (playerA.equalsIgnoreCase("P")
                        && playerB.equalsIgnoreCase("R"))
                        || (playerA.equalsIgnoreCase("S")
                        && playerB.equalsIgnoreCase("P"))
        ) {
            if (playerA.equalsIgnoreCase("R")) {
                System.out.println("Rock breaks Scissors");
            } else if (playerA.equalsIgnoreCase("P")) {
                System.out.println("Paper covers Rock");
            } else {
                System.out.println("Scissors cuts Paper");
            }

            System.out.println("Player A wins!");
        } else {
            if (playerB.equalsIgnoreCase("R")) {
                System.out.println("Rock breaks Scissors");
            } else if (playerB.equalsIgnoreCase("P")) {
                System.out.println("Paper covers Rock");
            } else {
                System.out.println("Scissors cuts Paper");
            }

            System.out.println("Player B wins!");
        }

        in.close();
    }
}
