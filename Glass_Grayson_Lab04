public static void main(String[] args) {

    double balance = 5000.00;
    double interestRate = 0.17;

    double monthlyRate = interestRate / 12;

    double oneMonthInterest = balance * monthlyRate;

    double twoMonthInterest = oneMonthInterest * 2;

    System.out.println("Starting credit card balance: $" + balance);
    System.out.println("Interest due after one month: $" + oneMonthInterest);
    System.out.println("Interest due after two months: $" + twoMonthInterest);

}

